{
  "version": "2.6",
  "groups": [
    {
      "name": "Spelling",
      "urls": [],
      "substitutions": [
        {
          "input": "colour",
          "inputType": "wholewords",
          "outputType": "text",
          "output": "color",
          "caseSensitive": false
        },
        {
          "input": "(\\d+)F",
          "inputType": "regexp",
          "outputType": "text",
          "output": "$1 degrees",
          "caseSensitive": true
        },
        {
          "input": "line\\nbreak",
          "inputType": "text",
          "outputType": "text",
          "output": "a\\\\b",
          "caseSensitive": false
        }
      ],
      "html": "none",
      "enabled": true,
      "mode": "auto&manual"
    },
    {
      "name": "",
      "urls": ["example.com", "-example.com/admin", "|https://docs.test/*", "search?q="],
      "substitutions": [
        {
          "input": "foo",
          "inputType": "text",
          "outputType": "function",
          "output": "match.toUpperCase()",
          "caseSensitive": false
        },
        { "input": "bar", "inputType": "text", "outputType": "text", "output": "baz", "caseSensitive": false }
      ],
      "html": "none",
      "enabled": false,
      "mode": "manual"
    },
    {
      "name": "Markup",
      "urls": [],
      "substitutions": [
        { "input": "x", "inputType": "text", "outputType": "text", "output": "<b>x</b>", "caseSensitive": false }
      ],
      "html": "output",
      "enabled": true,
      "mode": "auto"
    }
  ]
}
